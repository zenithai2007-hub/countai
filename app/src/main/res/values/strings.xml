    <!-- Settings: privacy -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_text">Counting happens 100% on your phone — camera, photos and videos are analyzed on-device and never uploaded automatically. If you sign in and turn on Cloud backup, only counting numbers (and small thumbnails, on WiFi) are synced to your private cloud account. Location is saved only if you enable it above.</string>

