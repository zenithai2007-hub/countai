    <!-- Settings -->
    <string name="confidence_title">Detection confidence</string>
    <string name="confidence_hint">Lower finds more objects but makes more mistakes. 0.50 is a good default.</string>
    <string name="fps_title">Detection speed</string>
    <string name="fps_hint">Frames analyzed per second. Lower saves battery and runs smoother on old phones.</string>
    <string name="gpu_title">GPU acceleration</string>
    <string name="gpu_hint">Tried first when your phone supports it; falls back to CPU automatically.</string>
    <string name="nnapi_title">NNAPI (Android neural API)</string>
    <string name="about_model_title">About the AI model</string>
    <string name="model_info_text">CountAI runs a quantized SSD-MobileNet object detector fully on your phone — no internet needed. It recognizes 80 everyday COCO classes (person, bottle, chair, car, cup, dog, cat, …). Note: COCO has no “box” class — cardboard boxes are usually detected as “suitcase”, “book” or “refrigerator” depending on shape.</string>
    <string name="custom_model_title">Use your own model</string>
    <string name="custom_model_text">To count your own products, fruits or inventory: train a model (e.g. in Teachable Machine or with YOLO → TFLite), then replace app/src/main/assets/detect.tflite and labels.txt and rebuild. The Detector interface keeps the UI untouched. Full steps are in the README.</string>
    <string name="version_text">CountAI v2.0.0 — on-device AI, private by design.</string>

